{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch --path tsconfig.dev.json",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "tsx --test test/*.test.ts",
    "prisma:validate": "prisma validate",
    "predev": "prisma generate",
    "prebuild": "prisma generate",
    "pretypecheck": "prisma generate",
    "prisma:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "employees:permissions": "tsx scripts/employee-permissions.ts",
    "employees:seed": "tsx scripts/seed-employees-demo.ts",
    "employees:seed:clean": "tsx scripts/seed-employees-demo.ts --clean",
    "test:employees": "node --test test/employees.integration.cjs",
    "auth:bootstrap": "tsx scripts/bootstrap.ts && tsx scripts/employee-permissions.ts",
    "auth:reset-password": "tsx scripts/reset-password.ts",
    "test:integration": "node --test test/auth.integration.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "@types/nodemailer": "^8.0.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "nodemailer": "^10.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prisma": "7.10.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}